# OpenClaw V2 Environment Configuration
# 
# NOTE: OpenClaw CLI V2 now uses secure OS Keyring storage!
# You do NOT need to set these in a local .env file. If you run the CLI without these,
# it will gracefully prompt you for them and securely store them in your OS Credential Manager.
# 
# However, if you are running in CI/CD or prefer to override the keyring, 
# you can still provide them via .env:

# CockroachDB MCP Connection (Required for TUI and Live Agent Memory Streaming)
MCP_ENDPOINT="https://cockroachlabs.cloud/mcp"
MCP_API_KEY="your_cockroach_api_key_here"
MCP_CLUSTER_ID="your_cockroach_cluster_id_here"
MCP_DATABASE="workforce_os"

# AWS Bedrock AgentCore URL (Required for Natural Language LLM Parsing)
AWS_AGENTCORE_ENDPOINT="http://localhost:8000/api/v1/chat"

# Web UI Dashboard URL
WEB_UI_URL="https://kaiso-os.vercel.app/"
